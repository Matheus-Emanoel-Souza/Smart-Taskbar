<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Authors>Smart Taskbar</Authors>
    <Product>Smart Taskbar</Product>
    <!--
      Alvo atual: net9.0 (SDK .NET 10 ainda não disponível na máquina de build).
      Migrar para net10.0 / C# 14 assim que o SDK estiver instalado — basta
      trocar o TargetFramework de cada .csproj para net10.0[-windows].
    -->
  </PropertyGroup>

</Project>
