<Window x:Class="SmartTaskbar.App.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartTaskbar.App.ViewModels"
        Title="Smart Taskbar — Gerenciador"
        Background="#14141a"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="640" MinHeight="420"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="🗂️" FontSize="22" Margin="0,0,10,0" />
            <TextBlock Text="Gerenciador de contextos" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ManagerColumnViewModel}">
                            <Border Width="300" Margin="0,0,16,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    AllowDrop="True"
                                    DragEnter="OnColumnDragEnter"
                                    DragLeave="OnColumnDragLeave"
                                    Drop="OnColumnDrop">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Editar..." Command="{Binding Header.RenameCommand}" />
                                                <MenuItem Header="Mover para a esquerda" Command="{Binding Header.MoveUpCommand}" />
                                                <MenuItem Header="Mover para a direita" Command="{Binding Header.MoveDownCommand}" />
                                                <Separator />
                                                <MenuItem Header="Excluir" Command="{Binding Header.DeleteCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header.Icon}" FontSize="17" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Header.Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="9"
                                                    MinWidth="18" Height="18" Margin="8,0,0,0" Padding="4,0">
                                                <TextBlock Text="{Binding Header.WindowCount}" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,6,10">
                                        <ItemsControl ItemsSource="{Binding Windows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:WindowItemViewModel}">
                                                    <Button Style="{StaticResource WindowRowStyle}"
                                                            Command="{Binding ActivateCommand}"
                                                            PreviewMouseLeftButtonDown="OnRowPreviewMouseDown"
                                                            PreviewMouseMove="OnRowPreviewMouseMove"
                                                            ToolTip="Clique para abrir · arraste até outra pasta para mover">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Mover para" ItemsSource="{Binding MoveTargets}">
                                                                    <MenuItem.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:MoveTargetViewModel}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                                                <TextBlock Text="{Binding Name}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </MenuItem.ItemTemplate>
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Command" Value="{Binding Command}" />
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <MenuItem Header="+ Criar novo contexto" Command="{Binding CreateContextAndMoveCommand}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Width="60" Height="60" FontSize="22" Content="+"
                        Style="{StaticResource ContextPillStyle}"
                        Command="{Binding AddContextCommand}"
                        ToolTip="Novo contexto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
