<Window x:Class="SmartTaskbar.App.Views.ContextPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartTaskbar.App.ViewModels"
        Title="Smart Taskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated"
        FontFamily="{StaticResource AppFont}">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MinWidth="260"
            MaxWidth="380"
            MaxHeight="440">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,6">
                <TextBlock Text="{Binding ContextIcon}" FontSize="16" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ContextName}" Style="{StaticResource PanelTitleStyle}" Margin="0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Padding="6,0,6,10">
                <ItemsControl ItemsSource="{Binding Windows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WindowItemViewModel}">
                            <Button Style="{StaticResource WindowRowStyle}"
                                    Command="{Binding ActivateCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mover para" ItemsSource="{Binding MoveTargets}">
                                            <MenuItem.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MoveTargetViewModel}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </MenuItem.ItemTemplate>
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="+ Criar novo contexto" Command="{Binding CreateContextAndMoveCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Title}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
