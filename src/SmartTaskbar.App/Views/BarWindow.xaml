<Window x:Class="SmartTaskbar.App.Views.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartTaskbar.App.ViewModels"
        xmlns:models="clr-namespace:SmartTaskbar.App.Models"
        Title="Smart Taskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <ContextMenu x:Key="BarDockMenu">
            <MenuItem Header="Livre (arrastar)" Command="{Binding SetDockModeCommand}" CommandParameter="{x:Static models:BarDockMode.Free}" />
            <MenuItem Header="Encaixar no topo" Command="{Binding SetDockModeCommand}" CommandParameter="{x:Static models:BarDockMode.Top}" />
            <MenuItem Header="Encaixar embaixo" Command="{Binding SetDockModeCommand}" CommandParameter="{x:Static models:BarDockMode.Bottom}" />
            <MenuItem Header="Encaixar à esquerda" Command="{Binding SetDockModeCommand}" CommandParameter="{x:Static models:BarDockMode.Left}" />
            <MenuItem Header="Encaixar à direita" Command="{Binding SetDockModeCommand}" CommandParameter="{x:Static models:BarDockMode.Right}" />
            <Separator />
            <MenuItem Header="Abrir gerenciador (tela cheia)" Click="OnOpenManagerClick" />
        </ContextMenu>
    </Window.Resources>
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="6"
            MouseLeftButtonDown="OnDragHandle">
        <Border.ContextMenu>
            <StaticResource ResourceKey="BarDockMenu" />
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal">
            <!--
                Menu de encaixe/travar TAMBÉM no botão de expandir/recolher (não só no fundo do
                Border): com poucos contextos a barra vira quase só botões, sobrando pouca área
                "vazia" pra clicar direto no Border — este botão sempre existe e é sempre visível.
            -->
            <Button Style="{StaticResource ContextPillStyle}"
                    Command="{Binding ToggleExpandCommand}"
                    ToolTip="Clique: minimizar/expandir · botão direito: fixar posição"
                    ContextMenu="{StaticResource BarDockMenu}">
                <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ExpandGlyphConverter}}" FontSize="13" />
            </Button>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Contexts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ContextViewModel}">
                        <Button Style="{StaticResource ContextPillStyle}"
                                Click="OnContextPillClick"
                                AllowDrop="True"
                                DragEnter="OnPillDragEnter"
                                DragLeave="OnPillDragLeave"
                                Drop="OnPillDrop">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Editar..." Command="{Binding RenameCommand}" />
                                    <MenuItem Header="Mover para cima" Command="{Binding MoveUpCommand}" />
                                    <MenuItem Header="Mover para baixo" Command="{Binding MoveDownCommand}" />
                                    <Separator />
                                    <MenuItem Header="Excluir" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentBrush}"
                                        CornerRadius="9" MinWidth="18" Height="18"
                                        Margin="6,0,0,0" Padding="4,0">
                                    <TextBlock Text="{Binding WindowCount}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+" Width="28" Height="28" Margin="4,0,0,0"
                    Foreground="{StaticResource TextSecondaryBrush}" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" FontSize="16"
                    Command="{Binding AddContextCommand}"
                    ToolTip="Novo contexto" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
